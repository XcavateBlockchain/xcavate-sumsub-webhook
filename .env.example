# Alchemy API key — the RPC endpoint is built from it and SOLANA_CLUSTER, e.g.
# https://solana-devnet.g.alchemy.com/v2/<key>. Create one at
# https://dashboard.alchemy.com (App → Solana → API key).
ALCHEMY_API_KEY=

# Which cluster to talk to: devnet (default) or mainnet-beta.
SOLANA_CLUSTER=devnet

# Optional: a full RPC URL. Set this only to bypass Alchemy (self-hosted node,
# another provider); it overrides ALCHEMY_API_KEY. Leave empty otherwise —
# without it and without an Alchemy key, the rate-limited public RPC is used.
SOLANA_RPC_URL=

# Whitelist admin signer — the raw secret key as a JSON array of numbers, the
# same format `solana-keygen new -o admin.json` writes. The address must be a
# registered admin on the xcavate_whitelist program (see README) and hold SOL:
# it pays transaction fees and the rent for every role account it creates.
# A path to a keypair JSON file is also accepted, which is handy locally.
ADMIN_PRIVATE_KEY=[12,34,...]

# What to do when a user FAILS KYC and already holds the role:
#   revoke (default) — keep the role, set its permission to Revoked
#   remove           — close the role account entirely
REJECTED_ROLE_ACTION=revoke

# Optional SOL drip to newly approved users, in SOL (e.g. 0.05).
# 0 or unset disables it — a user needs no SOL to be whitelisted, since the
# admin pays the role account's rent.
FAUCET_SOL_AMOUNT=0

# Sumsub webhook secret key (from Dashboard → Dev space → Webhooks → Webhook
# manager). When set, every webhook is verified via the X-Payload-Digest
# header and forged requests are rejected. Strongly recommended in production.
SUMSUB_SECRET=

# ── tgbp.io customer registration ──────────────────────────────────────
# After an approval lands on-chain, the user is also registered as a
# customer on tgbp.io. ALL THREE of the variables below must be set for this
# to run; if any is missing the step is skipped (and flagged at boot).

# tgbp.io API base URL. Sandbox by default; use https://api.tgbp.io for the
# live API.
TGBP_API_BASE_URL=https://sandbox.tgbp.io

# tgbp.io API key (the real one, created in the tgbp.io portal — sandbox keys
# are prefixed `tgbp_sandbox_`). Sent in the `X-API-Key` header: that is the
# server-to-server auth per the API reference (JWT Bearer is the web/mobile
# flow only).
TGBP_API_KEY=

# Sumsub client (app) token for THIS service's Sumsub account (Dashboard →
# Dev space → API). Used to mint the Reusable KYC share token
# (POST /resources/accessTokens/shareToken). This is the API app token —
# NOT the webhook secret key above. If your KYC flow runs in Sumsub's
# sandbox, use the app token from the SANDBOX dashboard: the service
# detects sandbox applicants via the webhook payload's sandboxMode flag
# and calls api.sandbox.sumsub.com for them (a cross-universe token is
# rejected with a 403 "Unauthorized").
SUMSUB_APP_TOKEN=

# tgbp.io's Sumsub client ID — the `forClientId` of the share token, i.e.
# the recipient side of the Reusable KYC share.
SUMSUB_RECIPIENT_CLIENT_ID=

# Share-token time-to-live in seconds (Sumsub default 1200).
SUMSUB_SHARE_TOKEN_TTL=1200

# Server port
PORT=8005
