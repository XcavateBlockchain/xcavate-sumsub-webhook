# Blockchain endpoints (at least one must be set)
TESTNET_WS_URL=wss://xcavate-solochain.api.onfinality.io/public-ws
MAINNET_WS_URL=

# Faucet account mnemonic (must have Admin role on the whitelist pallet)
FAUCET_MNEMONIC=

# Server port
PORT=8005

# Sumsub webhook secret key (from Dashboard → Dev space → Webhooks → Webhook
# manager). When set, every webhook is verified via the X-Payload-Digest
# header and forged requests are rejected. Strongly recommended in production.
SUMSUB_SECRET=